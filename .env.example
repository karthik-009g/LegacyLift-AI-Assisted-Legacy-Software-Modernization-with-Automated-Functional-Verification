# Copy to .env and fill in keys only for optional cloud proposal generation.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional explicit zero-price model; see docs/v2-operations.md.
LEGACYLIFT_OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Default Gemini model used by v2; process-level LEGACYLIFT_GEMINI_MODEL can override it.
LEGACYLIFT_GEMINI_MODEL=gemini-3.5-flash-lite

# Leave these blank for the default local SQLite store and single-process worker.
# For optional local Postgres/Valkey, see docs/v2-operations.md.
LEGACYLIFT_DATABASE_URL=
LEGACYLIFT_REDIS_URL=
LEGACYLIFT_POSTGRES_PASSWORD=local-only-change-me
